# Config for gdrive-mirror.sh. Copy to `gdrive.env` next to the script on the
# N5 (it is git-ignored). Every value here is the built-in default unless noted —
# only set the lines you need to change.

# Healthchecks dead-man's-switch (use a separate check from the vv mirror).
HC_URL=
#HC_CURL_OPTS="--resolve hc.example.ts.net:8443:100.64.0.30"
#NOTIFY_CMD=/path/to/notify.sh   # called with one message argument when a run fails

# --- Drive --------------------------------------------------------------------
# DRIVE_REMOTE: an rclone `drive` remote. Prefer one with your own Google Cloud
# OAuth client_id (rclone's shared one is rate-limited).
DRIVE_REMOTE=gdrive:
DRIVE_ROOT=Immich-DR
# CRYPT_REMOTE: an rclone `crypt` remote whose remote= is <DRIVE_REMOTE><DRIVE_ROOT>/_private.
# Keep its two passwords OFF this machine too (password manager), or the
# encrypted half of the backup dies with n5.
CRYPT_REMOTE=gdrive-dr-crypt:
#RCLONE_CONFIG=/home/<user>/.config/rclone/rclone.conf

# --- n5 (source) --------------------------------------------------------------
ORIGINALS=/mnt/tank/immich/originals
MEDIA=/mnt/tank/immich/media
ORIGINALS_DS=tank/immich/originals
MEDIA_DS=tank/immich/media
FLASH_DS=flash
FLASH_MOUNT=/mnt/flash
IMMY_STATE=/mnt/flash/immy/state
IMMY_SIDECARS=/mnt/flash/immy/sidecars
DUMP_DIR=/mnt/tank/immich/backups/nightly   # dump + recipe + manifest-stage/ come from nightly-mirror.sh

# --- scope / limits -------------------------------------------------------------
SKIP_DATED_VIDEO=1        # same scope as vv: no video under the dated YYYY/ tree
MAX_TRANSFER=700G         # per run (Google caps uploads at 750 GB/day)
PRIVATE_RESERVE=20G       # kept back from the file steps so the dump + immy state go up even while seeding
BWLIMIT=                  # e.g. 20M; empty = unlimited
MIN_DRIVE_FREE_GB=300     # refuse to run below this
MAX_DELETE=200            # per sync (deletions are moved into _history/, not lost)
HISTORY_DAYS=60           # _history/<run>/ retention
KEEP_DUMPS=7              # dumps kept in crypt:db/
MAX_DUMP_AGE_H=26         # refuse a dump older than this
MIN_ORIGINALS_FILES=1000  # refuse to sync from a near-empty originals snapshot
KEEP_LOG_DAYS=30

# Set 1 to make every run a dry-run; DRY_RUN=1 / VERIFY=1 on the command line win.
DRY_RUN=0
VERIFY=0
